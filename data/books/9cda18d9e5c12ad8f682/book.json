    },
    "adaptiveAnalysis": [
      {
        "key": "문학적 가치",
        "value": "한국 수필의 서정적 정수와 백미를 보여주는 클래식 에세이"
      }
    ],
    "keyEntitiesText": "피천득, 서영이, 엘리자베스 여왕",
    "settingText": "덕수궁, 비원, 영국 대사관, 서울의 봄 풍경"
  },
