    "adaptiveAnalysis": [
      {
        "key": "주요 생물",
        "value": "나르본늑대거미, 각종 벌과 여치류"
      }
    ],
    "keyEntitiesText": "파브르, 미슐레, 레옹 뒤프르, 나르본늑대거미, 보랏빛어리호박벌",
    "settingText": "남프랑스 세리냥의 아르마스 정원 및 연구실."
