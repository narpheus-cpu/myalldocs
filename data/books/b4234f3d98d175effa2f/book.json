    "adaptiveAnalysis": [
      {
        "key": "합종연횡",
        "value": "천하를 뒤흔든 유세객들의 외교 전략과 책략"
      }
    ],
    "keyEntitiesText": "소진, 장의, 주현왕, 연문공, 조숙후, 공손 연",
    "settingText": "전국시대 주나라, 진나라, 연나라, 조나라"
  },
