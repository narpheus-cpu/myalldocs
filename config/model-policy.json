{
  "description": "Runtime policy only. Concrete available models are discovered with models.list().",
  "zeroCostMode": true,
  "requireFreeTierPublishedModel": true,
  "retriesPerModel": 1,
  "maxModelCyclesPerRequest": 3,
  "modelCycleCooldownSeconds": 300,
  "modelCycleCooldownMaxSeconds": 900,
  "maxInvalidJsonRetries": 1,
  "maxInvalidJsonFallbacks": 1,
  "allowNamePatterns": [
    "^gemini-"
  ],
  "freeTierModelPatterns": [
    "^gemini-(?:3\\.8-flash|3\\.7-flash|3\\.6-flash|3\\.5-flash(?:-lite)?|3\\.1-flash-lite|2\\.5-flash(?:-lite)?)(?:-[0-9]{3})?$"
  ],
  "preferredModelOrder": [
    "gemini-3.8-flash",
    "gemini-3.7-flash",
    "gemini-3.6-flash",
    "gemini-3.5-flash",
    "gemini-2.5-flash",
    "gemini-3.5-flash-lite",
    "gemini-3.1-flash-lite",
    "gemini-2.5-flash-lite"
  ],
  "preferencePatterns": [
    "^gemini-[0-9]+(?:\\.[0-9]+)?-flash$",
    "^gemini-[0-9]+(?:\\.[0-9]+)?-flash-[0-9]{3}$",
    "^gemini-[0-9]+(?:\\.[0-9]+)?-flash-lite$",
    "^gemini-[0-9]+(?:\\.[0-9]+)?-flash-lite-[0-9]{3}$"
  ],
  "denyNameFragments": [
    "preview",
    "experimental",
    "exp-",
    "-exp",
    "latest",
    "deprecated",
    "retired",
    "legacy",
    "vision"
  ],
  "denyDescriptionFragments": [
    "deprecated",
    "retired",
    "shut down",
    "no longer available"
  ]
}
